# External, untracked runtime data directory. Do not place it inside this repository.
RADAR_DATA_DIR=/var/lib/ai-oss-radar

# Optional, untracked collector access credentials file.
# Relative paths resolve from deploy/docker-compose.collector.yml.
COLLECTOR_ENV_FILE=../collector/.env

# Keep the dashboard local to the host. Access it through an SSH tunnel.
DASHBOARD_BIND=127.0.0.1:8096
